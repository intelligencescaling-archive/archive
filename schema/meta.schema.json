{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intelscaling.com/schema/meta.schema.json",
  "title": "Archive entry (meta.yaml)",
  "description": "One archived item: a doc, story, or misc item, with one or more parts. See schema/README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "category", "title", "authors", "series", "characters", "tags",
               "language", "completion", "parts", "added", "review"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/slug"},
    "category": {"enum": ["doc", "story", "misc"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "alt_titles": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "authors": {
      "description": "Empty list = unknown author.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 100},
          "reddit": {"type": "string", "pattern": "^[A-Za-z0-9_-]{3,20}$"},
          "source": {"enum": ["doc-text", "library", "reddit-post", "submission", "manual"]}
        }
      }
    },
    "series": {"type": "array", "items": {"$ref": "#/$defs/slug"}, "uniqueItems": true},
    "characters": {"type": "array", "items": {"$ref": "#/$defs/slug"}, "uniqueItems": true},
    "variant": {"type": "string", "description": "Which version of the character/series, e.g. Light Novel, Composite, Movies."},
    "tags": {"type": "array", "items": {"$ref": "#/$defs/slug"}, "uniqueItems": true},
    "language": {"type": ["string", "null"], "pattern": "^[a-z]{2}$"},
    "completion": {"enum": ["finished", "in-progress", "unknown"]},
    "parts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/part"}},
    "found_in": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["library", "link_text"],
        "properties": {
          "library": {"enum": ["old", "remastered", "stories"]},
          "section": {"type": ["string", "null"]},
          "character": {"type": "string"},
          "link_text": {"type": "string"},
          "note": {"type": "string"}
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "url"],
        "properties": {
          "type": {"enum": ["reddit-post", "wayback", "discussion", "other"]},
          "url": {"$ref": "#/$defs/url"},
          "note": {"type": "string"}
        }
      }
    },
    "added": {"$ref": "#/$defs/date"},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["auto", "reviewed"]},
        "check": {"type": "array", "items": {"enum": ["title", "authors", "series", "characters", "tags", "language", "category"]}, "uniqueItems": true},
        "by": {"type": "string"},
        "date": {"$ref": "#/$defs/date"}
      }
    },
    "notes": {"type": "string"}
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "url": {"type": "string", "pattern": "^https?://"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "capture"],
      "properties": {
        "title": {"type": "string"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "url"],
          "properties": {
            "type": {"enum": ["google-doc", "google-doc-published", "google-drive-file", "google-slides", "reddit-post", "web-page", "other"]},
            "url": {"$ref": "#/$defs/url"},
            "google_id": {"type": "string", "pattern": "^[A-Za-z0-9_./-]{10,200}$"}
          }
        },
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {"enum": ["complete", "partial", "export-blocked", "dead", "private", "not-captured"]},
            "date": {"$ref": "#/$defs/date"},
            "pages": {"type": "integer", "minimum": 1},
            "words": {"type": "integer", "minimum": 0},
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["format", "name", "bytes", "sha256"],
                "properties": {
                  "format": {"enum": ["pdf", "docx", "html", "pptx", "epub", "png", "jpg", "txt"]},
                  "name": {"type": "string", "minLength": 1},
                  "bytes": {"type": "integer", "minimum": 0},
                  "sha256": {"$ref": "#/$defs/sha256"},
                  "url": {"$ref": "#/$defs/url"}
                }
              }
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "method"],
              "properties": {
                "file": {"type": "string", "pattern": "^text(?:-\\d+)?\\.txt$"},
                "method": {"enum": ["google-export", "pdf-extract", "html-extract", "docx-extract", "manual"]}
              }
            },
            "missing": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        }
      }
    }
  }
}
