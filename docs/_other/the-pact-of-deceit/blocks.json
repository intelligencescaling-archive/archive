{"k":"p","w":376,"r":[{"t":"Exposed","b":1},{"t":" players = anyone whose BID ≠ CLAIM."}]},
{"k":"li","w":385,"list":"ul","l":0,"m":"•","n":"10","r":[{"t":"Exposed players lose all the chips they bid to the Pot."}]},
{"k":"li","w":397,"list":"ul","l":0,"m":"•","n":"10","r":[{"t":"Non-Exposed players are “safe” — for now."}]},
{"k":"hr","w":404},
{"k":"h","w":405,"an":["_1dje45ypfln0"],"l":3,"r":[{"t":"Step 4 — Pot Resolution","b":1}]},
{"k":"li","w":411,"list":"ol","l":0,"m":"1.","n":"1","r":[{"t":"Pot =","b":1},{"t":" sum of all bids."}]},
{"k":"li","w":418,"list":"ol","l":0,"m":"2.","n":"1","r":[{"t":"Only "},{"t":"Non-Exposed","b":1},{"t":" players split the Pot equally."}]},
{"k":"li","w":426,"list":"ol","l":0,"m":"3.","n":"1","r":[{"t":"Each Non-Exposed player also keeps whatever chips they didn’t bid."}]},
{"k":"li","w":437,"list":"ol","l":0,"m":"4.","n":"1","r":[{"t":"Exposed players gain nothing from the Pot and keep only their unbid chips."}]},
{"k":"hr","w":450},
{"k":"h","w":451,"an":["_nkvvs58gvtzb"],"l":3,"r":[{"t":"Step 5 — Predator Rule","b":1}]},
{"k":"p","w":456,"r":[{"t":"If "},{"t":"everyone","b":1},{"t":" is Non-Exposed (all told the truth):"}]},
{"k":"li","w":465,"list":"ul","l":0,"m":"•","n":"4","r":[{"t":"The "},{"t":"lowest bidder","b":1},{"t":" immediately loses "},{"t":"half their chips","b":1},{"t":" to the "},{"t":"highest bidder","b":1},{"t":"."}]},
{"k":"li","w":478,"list":"ul","l":0,"m":"•","n":"4","r":[{"t":"If there’s a tie for lowest, all tied lowest bidders lose the penalty to the highest bidder (split equally if multiple highest)."}]},
{"k":"p","w":500,"r":[{"t":"This rule ensures that playing “perfectly safe” can backfire."}]},
{"k":"hr","w":509},
{"k":"h","w":510,"an":["_oaz75jugfw5a"],"l":3,"r":[{"t":"Step 6 — Winner Selection","b":1}]},
{"k":"li","w":516,"list":"ul","l":0,"m":"•","n":"8","r":[{"t":"Net Total =","b":1},{"t":" (chips kept) + (chips won from Pot) ± (Predator Rule gains/losses)."}]},
{"k":"li","w":531,"list":"ul","l":0,"m":"•","n":"8","r":[{"t":"The player with the highest Net Total wins the pod and advances."}]},
{"k":"li","w":544,"list":"ul","l":0,"m":"•","n":"8","r":[{"t":"Tie? Run a "},{"t":"Sudden Death Bluff Duel","b":1},{"t":":"}]},
{"k":"li","w":552,"list":"ul","l":1,"m":"•","n":"8","r":[{"t":"Each tied player privately sends "},{"t":"BID: 0–20 CLAIM: X","c":"c1"},{"t":"."}]},
{"k":"li","w":562,"list":"ul","l":1,"m":"•","n":"8","r":[{"t":"Repeat steps 2–4 for just those players; highest net wins."}]},
